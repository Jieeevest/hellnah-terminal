# Salin ke server/.env. Jangan pernah commit file ini setelah diisi.

# 'paper' = simulasi lokal, gak nyentuh Binance sama sekali selain baca data publik.
# 'live'  = order execution BENERAN ke Binance Futures mainnet, butuh BINANCE_API_KEY
#           + BINANCE_API_SECRET terisi (Futures enabled, TANPA permission withdrawal).
TRADING_MODE=paper
CONTROL_API_TOKEN=
ALLOWED_ORIGIN=http://localhost:5173
PORT=3010
# Kosong = 127.0.0.1 (cuma bisa diakses dari komputer ini). Di Docker otomatis 0.0.0.0
# lewat docker-compose.yml — jangan set 0.0.0.0 di sini untuk jalan lokal.
HOST=

# Modal virtual buat paper trading (USDT). Bukan saldo akun asli.
STARTING_EQUITY=1000
SCAN_INTERVAL_MS=60000
TICK_INTERVAL_MS=15000

# 'all' = scan semua pair USDT-M perpetual di Binance Futures, ranking top volume tiap siklus.
# 'fixed' = cuma scan simbol di WATCHLIST di bawah, abaikan volume.
WATCHLIST_MODE=all
MAX_WATCHLIST_SIZE=60
WATCHLIST=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT

# Cuma dibutuhkan kalau TRADING_MODE=live.
BINANCE_API_KEY=
BINANCE_API_SECRET=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
