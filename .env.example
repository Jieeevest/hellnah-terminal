# Salin file ini ke .env dan isi nilainya. Jangan pernah commit .env.
# Semua VITE_* di-inline ke bundle JS oleh Vite saat build — JANGAN taruh
# API key/secret yang bernilai uang (mis. exchange trading key) di sini.

VITE_DEV_MODE=
VITE_API_DOMAIN=
VITE_WS_DOMAIN=
VITE_TRADING_API_URL=
# Sama seperti key lain di atas, ini ke-inline ke bundle — cuma aman kalau backend
# trading dijalankan strictly localhost. Kosongkan kalau server/.env CONTROL_API_TOKEN kosong.
VITE_TRADING_API_TOKEN=
